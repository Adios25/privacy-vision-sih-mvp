{
  "manifest_version": 3,
  "name": "Privvy",
  "version": "1.3.3",
  "description": "Locally inspect, redact, and safely assist with the active page using a deterministic plan or sanitized server context.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://0.0.0.0/*"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Open Privvy",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "privvy-sih@example.test",
      "strict_min_version": "121.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["*.wasm", "*.mjs", "tesseract-worker.min.js", "eng.traineddata.gz", "yolo11n.onnx"],
      "matches": ["<all_urls>"]
    }
  ]
}
